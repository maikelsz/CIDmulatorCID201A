/ bootstrap, iniciar el progrma desde 0000
/ o ir directamente a 0200
*0000
               VEA I 0001
*0001
               0200

/ ═════ PÁGINA 0: datos, constantes, punteros ═════
*0002
C0,            0000
C1,            0000
C2,            0000
C3,            0000
C4,            0000
C5,            0000
C6,            0000
C7,            0000
C8,            0000
C9,            0000
C10,           0000
C11,           0000
C12,           0000
C13,           0000
C14,           0000
C15,           0000
N0,            0000
N1,            0000
N2,            0000
N3,            0000
N4,            0000
N5,            0000
N6,            0000
N7,            0000
N8,            0000
N9,            0000
N10,           0000
N11,           0000
N12,           0000
N13,           0000
N14,           0000
N15,           0000
TICK,          0000
GENCNT,        0000

/ K_GEN: una palabra por celda (0/1). Semilla = blinker vertical
/ (C1, C5, C9 vivos → evoluciona a blinker horizontal en fila 1)
K_GEN,
/ fila1
               0000
               0001
               0000
               0000
/ fila2
               0000
               0001
               0000
               0000
/ fila3
               0000
               0001
               0000
               0000
/ fila4
               0000
               0000
               0000
               0000

K_0,           0000
K_1,           0001
K_2,           0002
K_3,           0003
K_4,           0004
K_5,           0005
K_6,           0006
K_7,           0007
K_8,           0010
K_9,           0011
K_10,          0012
K_11,          0013
K_12,          0014
K_13,          0015
K_14,          0016
K_15,          0017
K_TICK,        7740               / -40 refrescos ≈ 184 ms
K_NEGGEN,      7634               / -100 generaciones
K_CR,          0010
K_LF,          0002
K_GENCOUNT,    0000               / 100 decimal (offset de generación)

P_GEN1,        GEN1_SLOT
P_GEN2,        GEN2_SLOT
P_GEN3,        GEN3_SLOT
P_GEN4,        GEN4_SLOT
P_DISPLAY,     DISP_SLOT

/ ═════ PÁGINA 1: MAIN, INIT, LOOP, HALT, GEN_SLOT ═════
/ inicio del programa
*0200
MAIN,          LAC
               SUM K_GEN
               DEL C0
               SUM K_GEN+1
               DEL C1
               SUM K_GEN+2
               DEL C2
               SUM K_GEN+3
               DEL C3
               SUM K_GEN+4
               DEL C4
               SUM K_GEN+5
               DEL C5
               SUM K_GEN+6
               DEL C6
               SUM K_GEN+7
               DEL C7
               SUM K_GEN+8
               DEL C8
               SUM K_GEN+9
               DEL C9
               SUM K_GEN+10
               DEL C10
               SUM K_GEN+11
               DEL C11
               SUM K_GEN+12
               DEL C12
               SUM K_GEN+13
               DEL C13
               SUM K_GEN+14
               DEL C14
               SUM K_GEN+15
               DEL C15

LOOP,          LAC
               SUM K_TICK
               DEL TICK
               LAC          
               SUM GENCNT   
               SUM K_GENCOUNT
               TAR           
DLP,           VAS I P_DISPLAY
               ISC TICK
               VEA DLP
               VAS GEN_SLOT
               ISC GENCNT
               VEA LOOP
HALT,          ALT
               VEA HALT

GEN_SLOT,      0000
               VAS I P_GEN1
               VAS I P_GEN2
               VAS I P_GEN3
               VAS I P_GEN4
               LAC
               SUM N0
               DEL C0
               SUM N1
               DEL C1
               SUM N2
               DEL C2
               SUM N3
               DEL C3
               SUM N4
               DEL C4
               SUM N5
               DEL C5
               SUM N6
               DEL C6
               SUM N7
               DEL C7
               SUM N8
               DEL C8
               SUM N9
               DEL C9
               SUM N10
               DEL C10
               SUM N11
               DEL C11
               SUM N12
               DEL C12
               SUM N13
               DEL C13
               SUM N14
               DEL C14
               SUM N15
               DEL C15
               VEA I GEN_SLOT

/ ═════ PÁGINA 2: DISPLAY multiplexado ═════
*0400
DISP_SLOT,     0000
               LAC
               SUM C0
               SAD
               VEA dskip0
               LAC
               SUM K_0
               TAT
dskip0,        SUM C1
               SAD
               VEA dskip1
               LAC
               SUM K_1
               TAT
dskip1,        SUM C2
               SAD
               VEA dskip2
               LAC
               SUM K_2
               TAT
dskip2,        SUM C3
               SAD
               VEA dskip3
               LAC
               SUM K_3
               TAT
dskip3,        SUM C4
               SAD
               VEA dskip4
               LAC
               SUM K_4
               TAT
dskip4,        SUM C5
               SAD
               VEA dskip5
               LAC
               SUM K_5
               TAT
dskip5,        SUM C6
               SAD
               VEA dskip6
               LAC
               SUM K_6
               TAT
dskip6,        SUM C7
               SAD
               VEA dskip7
               LAC
               SUM K_7
               TAT
dskip7,        SUM C8
               SAD
               VEA dskip8
               LAC
               SUM K_8
               TAT
dskip8,        SUM C9
               SAD
               VEA dskip9
               LAC
               SUM K_9
               TAT
dskip9,        SUM C10
               SAD
               VEA dskip10
               LAC
               SUM K_10
               TAT
dskip10,       SUM C11
               SAD
               VEA dskip11
               LAC
               SUM K_11
               TAT
dskip11,       SUM C12
               SAD
               VEA dskip12
               LAC
               SUM K_12
               TAT
dskip12,       SUM C13
               SAD
               VEA dskip13
               LAC
               SUM K_13
               TAT
dskip13,       SUM C14
               SAD
               VEA dskip14
               LAC
               SUM K_14
               TAT
dskip14,       SUM C15
               SAD
               VEA dskip15
               LAC
               SUM K_15
               TAT
dskip15,       VEA I DISP_SLOT

/ ═════ PÁGINA 3: GEN1 (C0..C4) ═════
*0600
GEN1_SLOT,     0000
/ C0 (nbrs: C1 C4 C5)
               LAC
               SUM C1
               SUM C4
               SUM C5
               CAC IAC
               SUM K_3
               SAC
               VEA g1c0_chk2
               VEA g1c0_one
g1c0_chk2,     CAC IAC
               IAC
               SAC
               VEA g1c0_zero
               LAC
               SUM C0
               SAC
               VEA g1c0_one
g1c0_zero,     LAC
               VEA g1c0_store
g1c0_one,      LAC
               IAC
g1c0_store,    DEL N0
/ C1 (nbrs: C0 C2 C4 C5 C6)
               LAC
               SUM C0
               SUM C2
               SUM C4
               SUM C5
               SUM C6
               CAC IAC
               SUM K_3
               SAC
               VEA g1c1_chk2
               VEA g1c1_one
g1c1_chk2,     CAC IAC
               IAC
               SAC
               VEA g1c1_zero
               LAC
               SUM C1
               SAC
               VEA g1c1_one
g1c1_zero,     LAC
               VEA g1c1_store
g1c1_one,      LAC
               IAC
g1c1_store,    DEL N1
/ C2 (nbrs: C1 C3 C5 C6 C7)
               LAC
               SUM C1
               SUM C3
               SUM C5
               SUM C6
               SUM C7
               CAC IAC
               SUM K_3
               SAC
               VEA g1c2_chk2
               VEA g1c2_one
g1c2_chk2,     CAC IAC
               IAC
               SAC
               VEA g1c2_zero
               LAC
               SUM C2
               SAC
               VEA g1c2_one
g1c2_zero,     LAC
               VEA g1c2_store
g1c2_one,      LAC
               IAC
g1c2_store,    DEL N2
/ C3 (nbrs: C2 C6 C7)
               LAC
               SUM C2
               SUM C6
               SUM C7
               CAC IAC
               SUM K_3
               SAC
               VEA g1c3_chk2
               VEA g1c3_one
g1c3_chk2,     CAC IAC
               IAC
               SAC
               VEA g1c3_zero
               LAC
               SUM C3
               SAC
               VEA g1c3_one
g1c3_zero,     LAC
               VEA g1c3_store
g1c3_one,      LAC
               IAC
g1c3_store,    DEL N3
/ C4 (nbrs: C0 C1 C5 C8 C9)
               LAC
               SUM C0
               SUM C1
               SUM C5
               SUM C8
               SUM C9
               CAC IAC
               SUM K_3
               SAC
               VEA g1c4_chk2
               VEA g1c4_one
g1c4_chk2,     CAC IAC
               IAC
               SAC
               VEA g1c4_zero
               LAC
               SUM C4
               SAC
               VEA g1c4_one
g1c4_zero,     LAC
               VEA g1c4_store
g1c4_one,      LAC
               IAC
g1c4_store,    DEL N4
               VEA I GEN1_SLOT

